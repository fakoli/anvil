{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pi-sandbox allowlist (M1: path: pins only)",
  "type": "object",
  "required": ["version", "profiles"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "$comment": { "type": "string" },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/profile" }
    }
  },
  "definitions": {
    "profile": {
      "type": "object",
      "required": ["extensions", "tools", "skills", "network"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "extensions": {
          "type": "array",
          "items": { "$ref": "#/definitions/extensionPin" }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$" }
        },
        "skills": { "type": "array", "maxItems": 0 },
        "network": { "enum": ["none", "inference"] }
      }
    },
    "extensionPin": {
      "type": "object",
      "required": ["source", "sha256"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "pattern": "^path:.+", "minLength": 6 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}